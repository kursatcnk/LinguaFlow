<Window x:Class="LinguaFlow.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinguaFlow Altyazı"
        Width="{Binding Width, Mode=TwoWay}"
        SizeToContent="Height" MinWidth="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Window.Resources>
        <!-- Klasik altyazı: metne sıkı oturan yarı saydam siyah kutu. -->
        <Style x:Key="CaptionBox" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,2,10,4"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Black" Opacity="{Binding BackgroundOpacity}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Neredeyse saydam arka plan: boştayken de fareyle tutulup taşınabilsin. -->
    <Grid x:Name="Root" Background="#01000000" MinHeight="64">
        <Border x:Name="HoverFrame" BorderBrush="#55FFFFFF" BorderThickness="1" Visibility="Hidden"/>

        <StackPanel VerticalAlignment="Bottom" Margin="12,30,12,8">
            <Border Style="{StaticResource CaptionBox}" Margin="0,0,0,2"
                    Visibility="{Binding HasPrevious, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding PreviousText}" FontSize="{Binding SecondaryFontSize}" Foreground="#B4B4B4"
                           TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource CaptionBox}"
                    Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding CurrentText}" FontSize="{Binding FontSize}" Foreground="White"
                           TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource CaptionBox}" Margin="0,2,0,0"
                    Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding OriginalText}" FontSize="{Binding OriginalFontSize}" Foreground="#A0A0A0"
                           TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Üzerine gelince -->
        <Border x:Name="Toolbar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                Background="#E6202020" CornerRadius="4" Padding="2" Visibility="Hidden">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Foreground="#8A8A8A" FontSize="11" Margin="6,0">
                    <Run Text="{Binding DetectedLanguageLabel, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding TargetLanguageLabel, Mode=OneWay}"/>
                </TextBlock>
                <Button Content="A−" Command="{Binding DecreaseFontCommand}" Style="{StaticResource OverlayButton}" ToolTip="Küçült"/>
                <Button Content="A+" Command="{Binding IncreaseFontCommand}" Style="{StaticResource OverlayButton}" ToolTip="Büyüt"/>
                <Button Command="{Binding ToggleOriginalCommand}" Style="{StaticResource OverlayButton}" ToolTip="Özgün metin"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE8D2;"/>
                <Button Command="{Binding ToggleBackgroundCommand}" Style="{StaticResource OverlayButton}" ToolTip="Arka plan"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE706;"/>
                <Button Command="{Binding HideCommand}" Style="{StaticResource OverlayButton}" ToolTip="Gizle"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE8BB;" FontSize="9"/>
            </StackPanel>
        </Border>

        <Thumb HorizontalAlignment="Left" Width="8" Cursor="SizeWE" DragDelta="OnResizeLeft" Opacity="0"/>
        <Thumb HorizontalAlignment="Right" Width="8" Cursor="SizeWE" DragDelta="OnResizeRight" Opacity="0"/>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Toolbar" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Toolbar" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}"/>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
