<Window x:Class="LinguaFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LinguaFlow"
        Width="1040" Height="700" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ToggleRunCommand}"/>
    </Window.InputBindings>

    <Border x:Name="RootBorder" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid>
                <TextBlock Text="LinguaFlow" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" Click="OnMinimizeClick" Style="{StaticResource WindowButton}"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Click="OnMaximizeClick" Style="{StaticResource WindowButton}"/>
                    <Button Content="&#xE8BB;" Click="OnCloseClick" Style="{StaticResource CloseWindowButton}"/>
                </StackPanel>
            </Grid>

            <!-- Araç çubuğu -->
            <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,6,14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Command="{Binding ToggleRunCommand}" Style="{StaticResource RunButton}"
                            AutomationProperties.Name="{Binding RunButtonText}" ToolTip="Ctrl+Enter">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="11" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE768;"/>
                                        <Setter Property="Foreground" Value="#151515"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="&#xE71A;"/>
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding RunButtonText}" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>

                    <ComboBox Grid.Column="1" Width="250" Margin="12,0,0,0" ToolTip="Dinlenecek ses çıkışı"
                              ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}"
                              IsEnabled="{Binding CanEditSettings}"/>

                    <ComboBox Grid.Column="2" Width="150" Margin="8,0,0,0" ToolTip="Konuşulan dil"
                              ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSourceLanguage}"
                              IsEnabled="{Binding CanEditSettings}"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="8,0"/>
                        <ComboBox Width="150" ToolTip="Çeviri dili"
                                  ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding SelectedTargetLanguage}"
                                  IsEnabled="{Binding CanEditSettings}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleOverlayCommand}" ToolTip="Altyazı şeridi">
                            <TextBlock Text="&#xE7F0;">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverlayVisible}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding CopyTranscriptCommand}" ToolTip="Dökümü kopyala">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ClearHistoryCommand}" ToolTip="Temizle">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="6" Command="{Binding ToggleSettingsCommand}" ToolTip="Ayarlar" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Döküm -->
                <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="860" Margin="32,20,32,28">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,18">
                                        <TextBlock Text="{Binding Translation}" FontSize="19" TextWrapping="Wrap" LineHeight="27"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                        <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0">
                                            <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource FaintBrush}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding OriginalLine, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{StaticResource LiveBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="-14,0,0,18"
                                Visibility="{Binding HasPartial, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding PartialTranslation}" FontSize="19" TextWrapping="Wrap" LineHeight="27"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#C9D9F2"/>
                                <TextBlock Text="{Binding PartialOriginal}" FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource FaintBrush}"
                           FontSize="13" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Text" Value="Başlat'a basın ve bir video ya da toplantı açın."/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsTranscriptEmpty}" Value="True"/>
                                        <Condition Binding="{Binding HasPartial}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Text" Value="Konuşma bekleniyor…"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Ayarlar paneli -->
                <Border Grid.Column="1" Width="280" Background="{StaticResource PaneBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,16,18,18">
                            <TextBlock Text="Ayarlar" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <TextBlock Text="Motor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                      IsEnabled="{Binding CanEditSettings}" Margin="0,0,0,14"/>

                            <StackPanel Visibility="{Binding IsLocalProvider, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Tanıma modeli" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding WhisperModels}" SelectedItem="{Binding SelectedWhisperModel}"
                                          IsEnabled="{Binding CanEditSettings}"/>
                                <TextBlock Text="{Binding LocalModelStatus}" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Margin="0,8,0,0"
                                             Visibility="{Binding IsDownloadingModels, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="Modelleri indir" Command="{Binding DownloadModelsCommand}" Style="{StaticResource LinkButton}"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding ModelsReady, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                                <TextBlock Text="Çeviri" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <ComboBox ItemsSource="{Binding TranslationEngineOptions}" SelectedItem="{Binding SelectedTranslationEngine}"
                                          IsEnabled="{Binding CanEditSettings}" Margin="0,0,0,14"/>
                            </StackPanel>

                            <TextBlock Text="Gecikme" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                                      IsEnabled="{Binding CanEditSettings}" Margin="0,0,0,14"/>

                            <StackPanel Visibility="{Binding IsAzureProvider, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Azure bölgesi" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding AzureRegion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                         IsEnabled="{Binding CanEditSettings}"/>
                                <TextBlock Text="Speech anahtarı" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="AzureKeyBox" PasswordChanged="OnAzureKeyChanged" IsEnabled="{Binding CanEditSettings}"/>
                            </StackPanel>

                            <TextBlock Text="Demo modu sahte metin üretir." FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                                       Visibility="{Binding IsDemoProvider, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Durum çubuğu -->
            <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding DiagnosticsText, Mode=OneWay}" Foreground="{StaticResource DangerBrush}"/>
                        <Run Text="{Binding ProviderStatus, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
